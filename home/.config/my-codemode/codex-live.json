{
  "sources": [
    {
      "name": "github",
      "transport": "http",
      "url": "https://api.githubcopilot.com/mcp/x/all",
      "headers": { "X-MCP-Readonly": "true" },
      "auth": {
        "type": "oauth",
        "clientIdEnv": "MCM_GITHUB_CLIENT_ID",
        "clientSecretEnv": "MCM_GITHUB_CLIENT_SECRET",
        "scope": "repo read:org read:user user:email read:packages read:project gist notifications",
        "callbackPort": 19877,
        "redirectUri": "http://127.0.0.1:19877/callback"
      }
    },
    {
      "name": "newrelic",
      "transport": "http",
      "url": "https://mcp.newrelic.com/mcp/",
      "auth": { "type": "oauth", "scope": "observability:read" }
    },
    {
      "name": "metabase",
      "transport": "http",
      "url": "https://metabase.prtimes-tools.jp/api/metabase-mcp",
      "auth": {
        "type": "oauth",
        "scope": "agent:query agent:query:construct agent:query:execute agent:question:execute agent:resource:read agent:search"
      }
    }
  ],
  "allow": [
    "github.actions_get",
    "github.actions_list",
    "github.check_dependency_vulnerabilities",
    "github.custom_properties_read",
    "github.get_code_quality_finding",
    "github.get_code_scanning_alert",
    "github.get_commit",
    "github.get_copilot_space",
    "github.get_dependabot_alert",
    "github.get_discussion",
    "github.get_discussion_comments",
    "github.get_file_contents",
    "github.get_gist",
    "github.get_global_security_advisory",
    "github.get_job_logs",
    "github.get_label",
    "github.get_latest_release",
    "github.get_me",
    "github.get_notification_details",
    "github.get_release_by_tag",
    "github.get_repository_tree",
    "github.get_secret_scanning_alert",
    "github.get_tag",
    "github.get_team_members",
    "github.get_teams",
    "github.github_support_docs_search",
    "github.issue_read",
