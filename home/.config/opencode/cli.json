{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "current",
    "mode": "system"
  },
  "keybinds": {
    "agent.cycle": "tab"
  },
  "tabs": {
    "layout": "horizontal",
    "scope": "cwd",
    "mode": "off"
  },
  "terminal": {
    "title": true,
    "copy": "select"
  },
  "session": {
    "permissions": "autoaccept",
    "sidebar": "hide",
    "scrollbar": false,
    "markdown": "rendered",
    "grouping": "none",
    "image_preview": true,
    "new_location": "launch",
    "thinking": "show"
  },
  "animations": true,
  "diffs": {
    "single": false,
    "view": "auto",
    "tree": false
  },
  "prompt": {
    "paste": "compact",
    "image_preview": true
  },
  "debug": {
    "devtools": false
  },
  "scroll": {
    "speed": 3
  },
  "attention": {
    "volume": 0.30000000000000004
  }
}
