          }
        },
        "gpt-6-sol-fast": {
          "settings": {
            "reasoningSummary": "auto",
            "include": ["reasoning.encrypted_content"]
          }
        },
        "gpt-6-luna": {
          "settings": {
            "reasoningSummary": "auto",
            "include": ["reasoning.encrypted_content"]
          }
        },
        "gpt-6-luna-fast": {
          "settings": {
