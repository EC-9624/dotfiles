{
  "$schema": "https://opencode.ai/config.json",
  "references": {
    "vault": {
      "path": "~/Code/agent-vault/",
      "description": "obsidian vault that act as durable memory for the user and AI agents"
    }
  },
  "permissions": [
    {
      "action": "external_directory",
      "resource": "~/Code/agent-vault/*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "~/Code/agent-vault/*",
      "effect": "allow"
    }
  ],
  "providers": {
    "openai": {
      "models": {
        "gpt-6.1-sol": {
          "limit": { "context": 500000 },
          "settings": {
            "reasoningSummary": "auto",
            "include": ["reasoning.encrypted_content"]
          }
        },
        "gpt-6.1-sol-fast": {
          "limit": { "context": 500000 },
          "settings": {
            "reasoningSummary": "auto",
            "include": ["reasoning.encrypted_content"]
          }
        },
        "gpt-6.1-sol-flex": {
          "limit": { "context": 500000 },
          "settings": {
            "reasoningSummary": "auto",
            "include": ["reasoning.encrypted_content"]
          }
        },
        "gpt-6.1-sol-ultrafast": {
          "limit": { "context": 500000 },
          "settings": {
            "reasoningSummary": "auto",
            "include": ["reasoning.encrypted_content"]
          }
        },
        "gpt-6.1-terra": {
          "limit": { "context": 500000 },
          "settings": {
            "reasoningSummary": "auto",
            "include": ["reasoning.encrypted_content"]
          }
        },
