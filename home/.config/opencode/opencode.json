{
  "$schema": "https://opencode.ai/config.json",
  "references": {
    "vault": {
      "path": "~/Code/agent-vault/",
      "description": "obsidian vault that act as durable memory for the user and AI agents"
    }
  },
  "permissions": [
    {
      "action": "external_directory",
      "resource": "~/Code/agent-vault/*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "~/Code/agent-vault/*",
      "effect": "allow"
    },
    {
      "action": "atlassian_*",
      "resource": "*",
      "effect": "deny"
    },
    {
      "action": "notion_*",
      "resource": "*",
      "effect": "deny"
    }
  ],
  "providers": {
    "openai": {
      "models": {
        "gpt-6-astra": {
          "limit": {
            "context": 525000,
            "input": 525000,
            "output": 128000
          }
        },
        "gpt-6-astra-fast": {
          "limit": {
            "context": 525000,
            "input": 525000,
            "output": 128000
          }
        },
        "gpt-5.6-sol": {
          "limit": {
            "context": 525000,
            "input": 525000,
            "output": 128000
          },
          "settings": {
            "reasoningSummary": "auto",
            "include": ["reasoning.encrypted_content"]
          }
        },
        "gpt-5.6-sol-fast": {
          "limit": {
            "context": 525000,
            "input": 525000,
            "output": 128000
          }
        },
        "gpt-5.6-luna": {
          "limit": {
            "context": 1050000,
            "input": 922000,
            "output": 128000
          },
          "settings": {
            "reasoningSummary": "auto",
            "include": ["reasoning.encrypted_content"]
          }
        },
        "gpt-5.6-luna-fast": {
          "limit": {
            "context": 1050000,
            "input": 922000,
            "output": 128000
          }
        },
        "gpt-5.6-terra": {
          "limit": {
            "context": 525000,
            "input": 525000,
            "output": 128000
          }
        },
        "gpt-5.6-terra-fast": {
          "limit": {
            "context": 525000,
            "input": 525000,
            "output": 128000
          }
        },
        "gpt-5.5": {
          "limit": {
            "context": 525000,
            "input": 525000,
            "output": 128000
          }
        },
        "gpt-5.5-fast": {
          "limit": {
            "context": 525000,
            "input": 525000,
            "output": 128000
          }
        },
        "gpt-5.4-mini": {
          "limit": {
            "context": 200000,
            "input": 200000,
            "output": 128000
          }
        },
        "gpt-5.4-mini-fast": {
          "limit": {
            "context": 200000,
            "input": 200000,
            "output": 128000
          }
        },
        "gpt-5.4": {
          "limit": {
            "context": 525000,
            "input": 525000,
            "output": 128000
          }
        },
        "gpt-5.4-fast": {
          "limit": {
            "context": 525000,
            "input": 525000,
            "output": 128000
          }
        },
        "gpt-5.3-codex-spark": {
          "limit": {
            "context": 64000,
            "input": 64000,
            "output": 32000
          }
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "figma-desktop": {
        "type": "remote",
        "url": "http://127.0.0.1:3845/mcp"
      },
      "notion": {
        "type": "remote",
        "url": "https://mcp.notion.com/mcp"
      },
      "newrelic": {
        "type": "remote",
        "url": "https://mcp.newrelic.com/mcp/"
      },
      "atlassian": {
        "type": "remote",
        "url": "https://mcp.atlassian.com/v1/mcp/authv2"
      },
      "metabase": {
        "type": "remote",
        "url": "https://metabase.prtimes-tools.jp/api/metabase-mcp"
      }
    }
  },
  "agents": {
    "jira": {
      "description": "Atlassian Jira specialist. Use for reading, searching, creating, updating, transitioning, and commenting on Jira issues. Invoke when the user references a Jira key, asks about tickets, sprints, JQL, or wants to file/update issues.",
      "mode": "subagent",
      "permissions": [
        {
          "action": "atlassian_*",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        }
      ]
    },
    "notion": {
      "description": "Notion specialist. Use for reading, searching, creating, and updating Notion pages, databases, and workspace content. Invoke when the user references Notion, pages, databases, docs, or workspace knowledge.",
      "mode": "subagent",
      "permissions": [
        {
          "action": "notion_*",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        }
      ]
    }
  }
}
