{
  "$schema": "https://opencode.ai/config.json",
  "references": {
    "vault": {
      "path": "~/Code/agent-vault/",
      "description": "obsidian vault that act as durable memory for the user and AI agents"
    }
  },
  "permissions": [
    {
      "action": "external_directory",
      "resource": "~/Code/agent-vault/*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "~/Code/agent-vault/*",
      "effect": "allow"
    }
  ],
  "providers": {
    "openai": {
      "models": {
        "gpt-6.1-sol": {
          "limit": {
            "context": 1050000,
            "input": 922000,
            "output": 128000
          },
          "settings": {
            "reasoningSummary": "auto",
            "include": ["reasoning.encrypted_content"]
          }
        },
        "gpt-6.1-sol-fast": {
          "limit": {
            "context": 1050000,
            "input": 922000,
            "output": 128000
          },
          "settings": {
            "reasoningSummary": "auto",
            "include": ["reasoning.encrypted_content"]
          }
        },
        "gpt-6-sol": {
          "limit": {
            "context": 1050000,
            "input": 922000,
            "output": 128000
          },
          "settings": {
            "reasoningSummary": "auto",
            "include": ["reasoning.encrypted_content"]
          }
        },
        "gpt-6-sol-fast": {
          "limit": {
            "context": 1050000,
            "input": 922000,
            "output": 128000
          },
          "settings": {
            "reasoningSummary": "auto",
            "include": ["reasoning.encrypted_content"]
          }
        },
        "gpt-6-luna": {
          "limit": {
            "context": 1050000,
            "input": 922000,
            "output": 128000
          },
          "settings": {
            "reasoningSummary": "auto",
            "include": ["reasoning.encrypted_content"]
          }
        },
        "gpt-6-luna-fast": {
          "limit": {
            "context": 1050000,
            "input": 922000,
            "output": 128000
          },
          "settings": {
            "reasoningSummary": "auto",
            "include": ["reasoning.encrypted_content"]
          }
        },
        "gpt-6-astra": {
          "limit": {
            "context": 1050000,
            "input": 922000,
            "output": 128000
          },
          "settings": {
            "reasoningSummary": "auto",
            "include": ["reasoning.encrypted_content"]
          }
        },
        "gpt-6-astra-fast": {
          "limit": {
            "context": 1050000,
            "input": 922000,
            "output": 128000
          },
          "settings": {
            "reasoningSummary": "auto",
            "include": ["reasoning.encrypted_content"]
          }
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "figma-desktop": {
        "type": "remote",
        "url": "http://127.0.0.1:3845/mcp",
        "disabled": true
      },
      // "codemode-mcp-gateway": {
      //   "type": "remote",
      //   "url": "http://127.0.0.1:4791/mcp",
      //   "oauth": false,
      //   "headers": {
      //     // The bearer lives in the gateway's private 0600 token file, never in this tracked config.
      //     "Authorization": "Bearer {file:~/.local/state/codemode-mcp-gateway/token}"
      //   },
      //   "codemode": false
      // },
      "notion": {
        "type": "remote",
        "url": "https://mcp.notion.com/mcp"
      },
      "newrelic": {
        "type": "remote",
        "url": "https://mcp.newrelic.com/mcp/"
      },
      "atlassian": {
        "type": "remote",
        "url": "https://mcp.atlassian.com/v1/mcp/authv2"
      },
      "metabase": {
        "type": "remote",
        "url": "https://metabase.prtimes-tools.jp/api/metabase-mcp",
        "oauth": {
          "scope": "agent:content:read agent:query:run agent:resource:read agent:sql:run"
        }
      }
    }
  }
}
