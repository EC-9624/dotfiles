        },
        "gpt-6.1-terra-flex": {
          "limit": { "context": 500000 },
          "settings": {
            "reasoningSummary": "auto",
            "include": ["reasoning.encrypted_content"]
          }
        },
        "gpt-6-sol": {
          "settings": {
