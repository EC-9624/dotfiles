#!/bin/sh
set -eu

bun="$HOME/.bun/bin/bun"
entrypoint="$HOME/.local/share/codemode-mcp-gateway/current/node_modules/codemode-mcp-gateway/dist/cli.js"

if [ ! -x "$bun" ] || [ ! -f "$entrypoint" ]; then
  printf '%s\n' 'gw is not installed. Install Bun 1.4.3, then run bun run install:local in the codemode-mcp-gateway repository.' >&2
  exit 1
fi

exec "$bun" "$entrypoint" "$@"
