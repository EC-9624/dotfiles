.DS_Store
backups/

# OpenCode generated content
home/.config/opencode/.git/
home/.config/opencode/node_modules/
home/.config/opencode/service.json
home/.config/opencode/state/
home/.config/opencode/themes/

# Agent runtime state; only selected portable configuration belongs in git
home/.agents/skills/synced/
home/.claude.json
home/.claude/*
!home/.claude/settings.json
!home/.claude/skills
!home/.claude/statusline-command.sh
home/.codex/*
!home/.codex/dotfiles.config.toml
home/.pi/*
!home/.pi/agent/
home/.pi/agent/*
!home/.pi/agent/settings.json
!home/.pi/agent/models.json
!home/.pi/agent/mcp.json

# Retired My CodeMode: keep any local OAuth state or scratch files untracked
home/.config/my-codemode/*
home/.local/state/my-codemode/
home/.local/share/codemode-mcp-gateway/
home/.local/state/codemode-mcp-gateway/

# OpenCode local runtime output
.opencode/plans/

# Local tmux plugins managed by TPM
home/.config/tmux/plugins/

# Local-only overrides (never commit)
home/.gitconfig.local
home/.zshrc.local
home/.zshenv.local
home/.zprofile.local

# Credential / secret stores
home/.netrc
home/.ssh/
home/.gnupg/
home/.aws/
home/.docker/
home/.kube/
home/.config/gh/
home/.config/op/
home/.config/1Password/

# Env files anywhere under home/
home/**/.env
home/**/.env.*
home/**/*.env

# Common token / key file shapes
home/**/*.pem
home/**/*.key
home/**/id_rsa*
home/**/id_ed25519*
home/**/*.token
