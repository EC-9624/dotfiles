#!/usr/bin/env bash

set -euo pipefail

export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/local/sbin:${PATH}"

DOTFILES_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HOME_DIR="${DOTFILES_DIR}/home"
PACKAGES_DIR="${DOTFILES_DIR}/packages"

say() {
  printf '%s\n' "$1"
}

fail() {
  printf 'error: %s\n' "$1" >&2
  exit 1
}

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || fail "missing command: $1"
}

install_packages() {
  need_cmd brew
  brew bundle --file="${PACKAGES_DIR}/bundle"
}

install_oh_my_zsh() {
  local omz_dir="${HOME}/.oh-my-zsh"

  if [[ -d "${omz_dir}/.git" ]]; then
    say "ok: oh-my-zsh"
    return 0
  fi

  if [[ -e "${omz_dir}" ]]; then
    fail "~/.oh-my-zsh exists but is not a git checkout"
  fi

  need_cmd git
  say "installing: oh-my-zsh"
  git clone --depth=1 https://github.com/ohmyzsh/ohmyzsh.git "${omz_dir}"
}

install_bun() {
  local bun_dir="${HOME}/.bun"
  local bun_bin="${bun_dir}/bin/bun"
  local bun_completion="${bun_dir}/_bun"

  if [[ -x "${bun_bin}" ]] && [[ -f "${bun_completion}" ]]; then
    say "ok: bun"
    return 0
  fi

  need_cmd bash
  need_cmd curl
  need_cmd unzip

  say "installing: bun"
  SHELL=sh BUN_INSTALL="${bun_dir}" bash -c "$(curl -fsSL https://bun.sh/install)"
  "${bun_bin}" completions > "${bun_completion}"
}

install_opencode2() {
  local opencode_bin="${HOME}/.opencode/bin/opencode2"

  if [[ -x "${opencode_bin}" ]] && "${opencode_bin}" --version >/dev/null 2>&1; then
    say "ok: opencode2"
    return 0
  fi

  need_cmd bash
  need_cmd curl
  say "installing: opencode2"
  curl -fsSL https://opencode.ai/v2/install | bash -s -- --no-modify-path

  "${opencode_bin}" --version >/dev/null 2>&1 || fail "opencode2 installation failed"
}

restow() {
  need_cmd stow
  stow -R -d "${DOTFILES_DIR}" -t "${HOME}" home
}

set_theme() {
  local name="${1:-}"
  local themes_dir="${HOME}/.config/themes"
  local theme_dir="${themes_dir}/${name}"
  local current_theme="${HOME}/.config/current-theme"
  local opencode_cli="${HOME}/.config/opencode/cli.json"
  local opencode_cli_tmp

  if [[ ! "$name" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
    fail "invalid theme name: ${name:-<empty>}"
  fi

  if [[ ! -d "$theme_dir" ]]; then
    fail "theme does not exist: $theme_dir"
  fi

  ln -nsf "$theme_dir" "$current_theme"

  if [[ -d "${HOME}/.config/tmux-palette" ]]; then
    printf '%s\n' '{' '  "name": "terminal"' '}' > "${HOME}/.config/tmux-palette/theme.json"
  fi

  if [[ -f "${current_theme}/opencode.json" ]]; then
    mkdir -p "${HOME}/.config/opencode/themes"
    cp "${current_theme}/opencode.json" "${HOME}/.config/opencode/themes/current.json"

    need_cmd jq
    opencode_cli_tmp="$(mktemp "${opencode_cli}.XXXXXX")"
    if [[ -f "${opencode_cli}" ]]; then
      jq '.theme.name = "current" | .theme.mode //= "system"' "${opencode_cli}" > "${opencode_cli_tmp}"
    else
      printf '%s\n' '{}' | jq '.theme.name = "current" | .theme.mode = "system"' > "${opencode_cli_tmp}"
    fi
    chmod 600 "${opencode_cli_tmp}"
    mv "${opencode_cli_tmp}" "${opencode_cli}"
  fi

  if command -v tmux >/dev/null 2>&1 && tmux list-sessions >/dev/null 2>&1; then
    tmux source-file "${HOME}/.config/tmux/tmux.conf"
  fi

  if pgrep -x btop >/dev/null 2>&1; then
    pkill -SIGUSR2 btop
  fi

  say "theme: $name"
  say "reload Ghostty with Cmd+Shift+,; restart open Neovim, Yazi, and opencode2 sessions"
}

ensure_theme() {
  if [[ ! -e "${HOME}/.config/current-theme" ]]; then
    set_theme tokyo-night
  fi
}

doctor() {
  local missing=0
  local commands=(bat brew bun cc curl delta eza fd fnm fzf git jq lazygit nvim opencode2 prettier prettierd rg starship stow stylua tar tmux tree-sitter unzip yazi zig zoxide zsh)
  local paths=(
    "${HOME}/.bun/_bun"
    "${HOME}/.oh-my-zsh/oh-my-zsh.sh"
    "${HOME}/.config/lazygit/config.yml"
    "${HOME}/.config/current-theme"
    "${HOME}/.config/themes/catppuccin"
    "${HOME}/.config/themes/rose-pine"
    "${HOME}/.config/themes/tokyo-night"
    "/opt/homebrew/opt/fzf/shell/key-bindings.zsh"
    "/opt/homebrew/opt/fzf-tab/share/fzf-tab/fzf-tab.zsh"
    "/opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
    "/opt/homebrew/share/zsh-completions"
    "/opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
  )

  for cmd in "${commands[@]}"; do
    if command -v "$cmd" >/dev/null 2>&1; then
      say "ok: $cmd"
    else
      say "missing: $cmd"
      missing=1
    fi
  done

  for path in "${paths[@]}"; do
    if [[ -e "$path" ]]; then
      say "ok: $path"
    else
      say "missing: $path"
      missing=1
    fi
  done

  if stow -n -R -d "${DOTFILES_DIR}" -t "${HOME}" home >/dev/null; then
    say "ok: stow dry-run"
  else
    say "warning: stow dry-run reported conflicts"
    missing=1
  fi

  return "$missing"
}

usage() {
  cat <<'EOF'
Usage: ./dot <command>

Commands:
  init    install bundle, bun, oh-my-zsh, and stow files
  stow    restow managed files into $HOME
  theme   switch terminal theme: ./dot theme <name>
  doctor  check core commands and stow health
EOF
}

main() {
  local command="${1:-help}"

  case "$command" in
    init)
      install_packages
      install_bun
      install_opencode2
      install_oh_my_zsh
      restow
      ensure_theme
      ;;
    stow)
      restow
      ensure_theme
      ;;
    theme)
      set_theme "${2:-}"
      ;;
    doctor)
      doctor
      ;;
    help|-h|--help)
      usage
      ;;
    *)
      usage
      fail "unknown command: $command"
      ;;
  esac
}

main "$@"
